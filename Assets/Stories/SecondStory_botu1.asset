        Background: {fileID: 1889115725136107946, guid: aa925b2adaaef76469f5a70d0696ec15, type: 3}
        CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
        StoryText: "\u300C\u3044\u3044\u3084\u3002\u5143\u3005\u306F\u9060\u3044\u5834\u6240\u306B\u4F4F\u3093\u3067\u305F\u3093\u3060\u3002\n\u3000\u3053\u3053\u304B\u3089\u306F\u305A\u3063\u3068\u9060\u3044\u9060\u3044\u5834\u6240\u304B\u3089\u98DB\u3093\u3067\u304D\u305F\u3093\u3060\u300D"
