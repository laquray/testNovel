        StoryText: "\u300C\u541B\u3068\u51FA\u4F1A\u3063\u305F\u65E5\u3060\u3088\u3002\n\u3000\u4E01\u5EA6\u3001\u50D5\u304C\u3053\u306E\u6751\u306B\u6765\u305F\u3068\u304D\u3060\u3063\u305F\u304B\u306A\u300D"
        CharacterName: "\u7DD1\u7389"
        SE: {fileID: 0}
        SEAmount: 1
    - rid: 5401627507227361380
      type: {class: SelifEvent, ns: , asm: Assembly-CSharp}
      data:
        Background: {fileID: 1889115725136107946, guid: aa925b2adaaef76469f5a70d0696ec15, type: 3}
        CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
        StoryText: "\u300C\u304A\u8179\u304C\u7A7A\u3044\u3066\u3044\u3066\u3001\u3082\u3046\u52D5\u3051\u306A\u3044\u306A\u30FC\u3063\u3066\u601D\u3063\u3066\u305F\u3068\u304D\u3001\n\u3000\u541B\u304C\u3053\u3053\u306B\u5C45\u305F\u3093\u3060\u3088\u306D\u3002\n\u3000\u4ECA\u65E5\u307F\u305F\u3044\u306B\u3001\u304A\u83D3\u5B50\u3092\u304F\u308C\u305F\u3093\u3060\u3088\u300D"
