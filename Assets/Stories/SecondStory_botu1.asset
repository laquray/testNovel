        CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
        StoryText: "\u305D\u3046\u3060\u3063\u305F\u306E\u304B\uFF1F\n\u968F\u5206\u3068\u524D\u306E\u3053\u3068\u3060\u304B\u3089\u3060\u308D\u3046\u304B\u3001\n\u9BAE\u660E\u306B\u601D\u3044\u51FA\u3059\u3053\u3068\u304C\u3067\u304D\u306A\u3044\u3002"
        CharacterName: 
