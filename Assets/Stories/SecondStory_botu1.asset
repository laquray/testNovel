        StoryText: "\u300C\u305D\u306E\u6642\u306B\u5049\u3044\u4EBA\u306B\u983C\u307E\u308C\u3066\u3055\u3002\n\u3000\u300E\u7DD1\u7389\u300F\u69D8\u3068\u3057\u3066\u632F\u821E\u3046\u306A\u3089\u3001\n\u3000\u3053\u306E\u6751\u3067\u4F4F\u3093\u3067\u3044\u3044\u3063\u3066\u8A00\u308F\u308C\u3066\u3055\u300D"
