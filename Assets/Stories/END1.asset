        StoryText: "\u300C\u3046\u308F\u3041\u3063\u3001\u6CE3\u304F\u306A\u3088\u5927\u8888\u88DF\u3060\u306A\u3002\n\u3000\u305D\u3093\u306A\u306B\u559C\u3076\u3053\u3068\u304B\uFF1F\u300D"
