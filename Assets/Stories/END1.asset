        StoryText: "\u305D\u3046\u8A00\u3063\u3066\u307F\u308B\u304C\u3001\u7DD1\u7389\u304B\u3089\u8FD4\u4E8B\u306F\u306A\u3044\u3002\n\u305D\u3093\u306A\u306B\u60DA\u3051\u3066\u3069\u3046\u3057\u305F\u3093\u3060\u3001\u3068\u58F0\u3092\u304B\u3051\u3088\u3046\u3068\u3059\u308B\u3068\u3002"
