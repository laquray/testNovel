        StoryText: "\u5B09\u3057\u6D99\u3092\u6D41\u3057\u306A\u304C\u3089\u3001\u5F7C\u306F\u305D\u3046\u8A9E\u308B\u3002\n\u2026\u2026\u305D\u3046\u304B\u3002\u81EA\u8EAB\u306E\u5B58\u5728\u3092\u3053\u3046\u3082\u6C42\u3081\u3089\u308C\u3068\u3001\n\u5B09\u3057\u3044\u3082\u306E\u306A\u306E\u304B\u3002"
