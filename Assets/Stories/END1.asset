        StoryText: "\u300C\u5225\u306B\u3001\u541B\u306E\u9858\u3044\u306A\u3089\u5E30\u308B\u306E\u3082\u3084\u3076\u3055\u304B\u3058\u3083\u306A\u3044\u3057\u3055\u3002\n\u3000\u307E\u3041\u3001\u9000\u8077\u5C4A\u63CF\u304B\u306A\u304D\u3083\u3060\u304B\u3089\u6642\u9593\u306F\u304B\u304B\u308B\u3051\u3069\u3001\n\u3000\u5E30\u3063\u305F\u3089\u307E\u305F\u3088\u308D\u3057\u304F\u983C\u3080\u3088\u300D"
