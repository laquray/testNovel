    CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
    StoryText: "\u307B\u3089\u3001\u3053\u3063\u3061\u3053\u3063\u3061\uFF01"
    CharacterName: "\uFF1F\uFF1F\uFF1F"
  - Background: {fileID: -6577454450327069383, guid: e11e2625bcfe0d7469da3125866dae87, type: 3}
    CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
    StoryText: "\u3042\u3041\u3001\u5206\u304B\u3063\u305F\u304B\u3089\u5F15\u3063\u5F35\u308B\u306A\u3001\u7DD1\u7389\uFF01\n\u304A\u524D\u3001\u529B\u5F37\u3044\u3093\u3060\u304B\u3089\u3002"
    CharacterName: 
  - Background: {fileID: -6577454450327069383, guid: e11e2625bcfe0d7469da3125866dae87, type: 3}
    CharacterImage: {fileID: 3361218868145291846, guid: 0b2af964e4061ba4987c2fa60726436c, type: 3}
    StoryText: "\u307E\u3001\u30C9\u30E9\u30B4\u30F3\u3060\u304B\u3089\u306D\u3002\n\u305D\u308A\u3083\u3042\u4EBA\u9593\u3068\u306F\u30B1\u30BF\u9055\u3044\u3060\u3088\u3002"
