  - Background: {fileID: -6577454450327069383, guid: e11e2625bcfe0d7469da3125866dae87, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u8FD1\u6240\u306E\u795E\u793E\u304B\u3089\u796D\u56C3\u5B50\u304C\u805E\u3053\u3048\u308B\u3002"
