        CharacterImage: {fileID: 0}
        StoryText: "\u3082\u3046\u76F4\u306B\u967D\u304C\u66AE\u308C\u308B\u3068\u3044\u3046\u306E\u306B\u3001\u3069\u3046\u3057\u3066\u3053\u3093\u306A\u306B\u6691\u3044\u3093\u3060\u3002\n\u5915\u967D\u306E\u8D64\u3055\u306B\u30A8\u30E2\u30FC\u30B7\u30E7\u30CA\u30EB\u306A\u6C17\u5206\u306B\u306A\u308B\u3053\u3068\u3082\u3067\u304D\u305A\u3001\n\u305F\u3060\u5F37\u3044\u65E5\u5149\u306B\u808C\u304C\u713C\u304B\u308C\u3066\u3044\u305F\u3002"
