        StoryText: "\u6E0B\u3005\u3068\u8A00\u3063\u305F\u69D8\u5B50\u306A\u304C\u3089\u3001\u7D0D\u5F97\u3057\u3066\u304F\u308C\u305F\u3088\u3046\u3060\u3002\n"
