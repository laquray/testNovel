        StoryText: "\u897F\u65E5\u5DEE\u3057\u8FBC\u3080\u5915\u66AE\u308C\u6642\u3002\n\u65E5\u4E2D\u306B\u6E29\u3081\u3089\u308C\u305F\u71B1\u6C17\u304C\u3001\u307E\u3060\u5730\u306B\u9019\u3063\u3066\u3044\u308B\u3002"
