        StoryText: "\u5F7C\u306E\u540D\u524D\u306F\u3001\u7DD1\u7389\u3002\n\u305D\u306E\u898B\u305F\u76EE\u306E\u901A\u308A\u306E\u9F8D\u3060\u3002\n\u305D\u306E\u5927\u304D\u3055\u306E\u5272\u306B\u306F\u81EA\u5206\u3068\u540C\u3044\u5E74\u3089\u3057\u3044\u3002"
