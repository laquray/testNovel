        Background: {fileID: -6577454450327069383, guid: e11e2625bcfe0d7469da3125866dae87, type: 3}
        CharacterImage: {fileID: 0}
        StoryText: "\u3055\u3059\u304C\u516B\u6708\u3068\u8A00\u3063\u305F\u3068\u3053\u308D\u304B\u3002\n\u5E74\u3005\u6691\u304F\u611F\u3058\u308B\u306E\u306F\u932F\u899A\u304B\u3069\u3046\u304B\u5206\u304B\u3089\u306A\u3044\u304C\u3001\n\u3068\u306B\u3082\u304B\u304F\u306B\u3082\u3001\u3053\u306E\u6691\u3055\u306B\u8EAB\u304C\u8339\u3067\u4E0A\u304C\u308A\u305D\u3046\u306B\u306A\u3063\u3066\u3044\u305F\u3002"
