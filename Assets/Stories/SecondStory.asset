        StoryText: "\u300C\u30D4\u30F3\u3068\u6765\u3066\u306A\u3044\uFF1F\n\u3000\u307E\u3041\u4ED6\u4EBA\u306B\u3057\u305F\u89AA\u5207\u3063\u3066\u5FD8\u308C\u304C\u3061\u3060\u3088\u306D\u3047\u300D"
