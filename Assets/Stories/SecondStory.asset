        StoryText: "\u300C\u541B\u3068\u51FA\u4F1A\u3063\u305F\u65E5\u3060\u3088\u3002\n\u3000\u4E01\u5EA6\u3001\u50D5\u304C\u3053\u306E\u6751\u306B\u6765\u305F\u3068\u304D\u3060\u3063\u305F\u304B\u306A\u300D"
